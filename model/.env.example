# Optional OpenAI-compatible external answer provider.
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=

# Local OpenAI-compatible model for grounded KB answers.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=

LLM_TIMEOUT_SECONDS=60

# Gemini text and vision fallback.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_VISION_TIMEOUT_SECONDS=90
GEMINI_VISION_MAX_RETRIES=1
GEMINI_VISION_TEMPERATURE=0.1
GEMINI_VISION_MAX_OUTPUT_TOKENS=2048

# Chat fallback modes: none, external, gemini.
# Blank auto-selects gemini when GEMINI_API_KEY is set.
CHAT_EXTERNAL_ANSWER_AGENT=gemini

# Multimodal modes: none, demo, external, gemini.
MATERIAL_MULTIMODAL_AGENT=gemini
CHAT_ATTACHMENT_MULTIMODAL_AGENT=gemini
